<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 9 diterapkan ke NUCEOS: Form Pengaduan Warga -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    tools:context=".PengaduanActivity">

    <!-- Tahap 0: Toolbar + tombol back -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/teal"
        app:titleTextColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Form dibungkus ScrollView supaya bisa digulir saat keyboard muncul -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Laporkan Masalah Kota"
                android:textColor="@color/charcoal"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Laporanmu akan diteruskan ke dinas terkait."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Tahap 1: TextInputLayout - Nama Pelapor -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNama"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="Nama Pelapor"
                app:boxStrokeColor="@color/teal"
                app:endIconMode="clear_text"
                app:errorEnabled="true"
                app:hintTextColor="@color/teal"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tahap 1: TextInputLayout - Judul Laporan dengan counter -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilJudul"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="Judul Laporan"
                app:boxStrokeColor="@color/teal"
                app:counterEnabled="true"
                app:counterMaxLength="50"
                app:errorEnabled="true"
                app:helperText="Contoh: Lampu jalan mati di Jl. Sudirman"
                app:hintTextColor="@color/teal"
                app:startIconDrawable="@drawable/ic_pengaduan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etJudul"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="50" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tahap 2: ChipGroup - Kategori Laporan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_semibold"
                android:text="Kategori"
                android:textColor="@color/charcoal"
                android:textSize="14sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupKategori"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipJalan"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Jalan Rusak" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSampah"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sampah" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBanjir"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Banjir" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLampu"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lampu Jalan" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Tahap 3.1: EditText dengan background membulat -->
            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_rounded_container"
                android:hint="Nomor HP (untuk dihubungi petugas)"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_rounded_container"
                android:gravity="top|start"
                android:hint="Ceritakan masalahnya dan lokasinya"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:textSize="14sp" />

            <!-- Tahap 1.4: MaterialButton berikon + ripple -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKirim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/teal"
                android:paddingVertical="12dp"
                android:text="Kirim Laporan"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_pengaduan"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:rippleColor="@color/champagne_gold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
